---
/**
 * A page with a sticky header — the bar on wide screens, the hamburger and
 * drawer below 768px — and enough content to scroll. `<ClientRouter />`
 * turns on view transitions, so navigating between the two pages swaps the
 * header the way a real Astro site does.
 */
import { ClientRouter } from 'astro:transitions';
import MenuBar from '../../../../../src/MenuBar.astro';
import MenuButton from '../../../../../src/MenuButton.astro';
import MenuDrawer from '../../../../../src/MenuDrawer.astro';
import { nav } from '../nav';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<ClientRouter />
		<style is:global>
			body { margin: 0; font: 16px/1.5 system-ui, sans-serif; }
			.site-header { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem 1.5rem; background: Canvas; border-bottom: 1px solid #ddd; }
			.site-header .menu-button { display: none; }
			@media (max-width: 767px) {
				.site-header .menu-bar { display: none; }
				.site-header .menu-button { display: inline-grid; }
			}
			main { padding: 1.5rem; }
			.tall { height: 150vh; }
		</style>
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="logo">Example</a>
			<MenuBar items={nav} />
			<MenuButton controls="site-menu" />
			<MenuDrawer id="site-menu" items={nav} closeAbove="(min-width: 768px)">
				<p slot="footer"><a href="mailto:hello@example.com">hello@example.com</a></p>
			</MenuDrawer>
		</header>
		<main>
			<h1>{title}</h1>
			<slot />
			<button type="button" id="behind">A button behind the drawer</button>
			<div class="tall"></div>
			<h2 id="pricing">Pricing</h2>
			<div class="tall"></div>
		</main>
	</body>
</html>
