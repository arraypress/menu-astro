---
/**
 * MenuDropdown.astro
 * ------------------
 *
 * A dropdown in the nav bar — a short list under its trigger, or with
 * `size="wide"` a mega panel across the header. Built on the WAI-ARIA
 * disclosure pattern: a `<button>` with `aria-expanded` and `aria-controls`,
 * and a panel of ordinary links that Tab moves through. Not `role="menu"`,
 * which is for application menus and has screen readers expect arrow keys
 * that a site's nav doesn't use.
 *
 * - Without `href`, the label is the button.
 * - With `href`, the label stays a link to that page and a separate toggle
 *   beside it opens the panel. A link that also opens a panel can't do both
 *   on touch or by keyboard — the tap navigates — so they're kept apart.
 * - Click, tap, Enter or Space opens it and pins it open. With a mouse,
 *   hovering opens it too (`hover`, on by default) and leaving closes it.
 *   Escape, Tab-ing out and pressing outside all close it.
 *
 * Fill the panel with `items` — each child a link, or with `size="wide"`,
 * children holding `items` of their own become headed columns — or with
 * your own markup in the default slot. With `items`, the `aside` slot sits
 * beside the links: a featured release or product next to a generated list.
 *
 * @example
 *   ---
 *   import { MenuDropdown } from '@arraypress/menu-astro';
 *   ---
 *   <MenuDropdown label="Plugins" href="/plugins" items={[
 *     { label: 'Forms', href: '/plugins/forms', description: 'Build any form' },
 *     { label: 'Shop', href: '/plugins/shop' },
 *   ]} />
 *
 *   <MenuDropdown label="Resources" size="wide">
 *     <YourMegaPanel />
 *   </MenuDropdown>
 *
 *   <MenuDropdown label="Products" href="/products" items={products}>
 *     <a slot="aside" href="/products/latest">Latest release</a>
 *   </MenuDropdown>
 */
import './styles/menu.css';
import MenuPanelLinks from './MenuPanelLinks.astro';
import { ariaCurrent, containsCurrent, format, makeId, resolveStrings } from './utils';
import type { MenuDropdownProps } from './types';

const {
	label,
	href,
	current,
	items,
	currentPath = Astro.url.pathname,
	id: idProp,
	size = 'default',
	align = 'start',
	hover = true,
	attrs,
	strings: stringsProp,
	class: className,
} = Astro.props as MenuDropdownProps;

const strings = resolveStrings(stringsProp);
const id = idProp ?? makeId(label, Astro.request);
const labelCurrent = ariaCurrent({ href, current }, currentPath);
/* A label with no page of its own still shows that you're somewhere in it. */
const sectionCurrent = !href && (items ?? []).some((item) => containsCurrent(item, currentPath));

/* Content to show beside the generated links — a featured card, say.
 * Rendered first and checked: a slot passed through a condition that came
 * out false (as <MenuBar> does) still counts as given, but renders nothing. */
const aside = items && Astro.slots.has('aside') ? (await Astro.slots.render('aside')).trim() : '';
---

<div
	class:list={['menu-dropdown', className]}
	data-menu-dropdown
	data-hover={hover ? '' : undefined}
	data-size={size}
	data-align={size === 'wide' ? undefined : align}
>
	{
		href ? (
			<>
				<a {...attrs} class="menu-dropdown__link" href={href} aria-current={labelCurrent}>{label}</a>
				<button
					type="button"
					class="menu-dropdown__toggle"
					aria-expanded="false"
					aria-controls={id}
					aria-label={format(strings.submenu, label)}
					data-menu-toggle
				>
					<svg class="menu-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg>
				</button>
			</>
		) : (
			<button
				type="button"
				class="menu-dropdown__trigger"
				aria-expanded="false"
				aria-controls={id}
				data-current={sectionCurrent ? '' : undefined}
				data-menu-toggle
			>
				<span>{label}</span>
				<svg class="menu-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg>
			</button>
		)
	}

	<div id={id} class="menu-dropdown__panel" data-menu-panel>
		{
			!items ? (
				<slot />
			) : aside ? (
				<div class="menu-dropdown__body">
					<div class="menu-dropdown__main">
						<MenuPanelLinks items={items} id={id} currentPath={currentPath} strings={strings} />
					</div>
					<div class="menu-dropdown__aside" set:html={aside} />
				</div>
			) : (
				<MenuPanelLinks items={items} id={id} currentPath={currentPath} strings={strings} />
			)
		}
	</div>
</div>

<script>
	import './runtime/menu';
</script>
